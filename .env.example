# Copy this file to .env and fill in your values (never commit .env)

# Azure AI Document Intelligence -> resource > Keys and Endpoint
DOCINTEL_ENDPOINT=https://<your-docintel-name>.cognitiveservices.azure.com/
DOCINTEL_KEY=<key1>

# Microsoft Foundry -> Models > claude-sonnet-5-5 > Details (Target URI + Key)
FOUNDRY_ANTHROPIC_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/anthropic/
FOUNDRY_API_KEY=<foundry-key>
FOUNDRY_DEPLOYMENT=claude-sonnet-5-5
